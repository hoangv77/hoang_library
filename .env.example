# Import-time credentials only. Never prefix secrets with VITE_.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
# Optional application contact for Open Library's User-Agent.
OPEN_LIBRARY_CONTACT=

# Optional browser-safe Supabase configuration for shared personal edits.
# Apply supabase/migrations and provision the owner first. Never use service-role/secret keys.
# Leave both Supabase values blank to use file editing with npm run dev.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
