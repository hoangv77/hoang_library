#!/bin/sh
set -eu
zero=0000000000000000000000000000000000000000
if [ -n "$(git status --porcelain)" ]; then
    echo 'Push blocked: commit or stash local changes first.' >&2
    exit 1
fi
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_ref" != refs/heads/main ] || [ "$remote_ref" != refs/heads/main ]; then
        echo 'Push blocked: this repo publishes only local main to remote main.' >&2
        exit 1
    fi
    approved=$(git rev-parse --verify refs/reviews/approved 2>/dev/null || true)
    if [ "$local_sha" != "$approved" ]; then
        echo 'Push blocked: this exact commit has not been approved after review.' >&2
        echo 'Use tools/git-workflow.ps1 review, then approve -Commit <full SHA>.' >&2
        exit 1
    fi
    if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
        echo 'Push blocked: fetch and integrate remote main, then review again.' >&2
        exit 1
    fi
done
